# Application
NODE_ENV=development
APP_NAME=XAPI
APP_VERSION=1.0.0
PORT=3001

# Database
DATABASE_URL=postgresql://xapi:password@localhost:5432/xapi

# Redis
REDIS_URL=redis://localhost:6379

# API Keys (for testing)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-your-anthropic-key
MOONSHOT_API_KEY=sk-your-moonshot-key
ZHIPU_API_KEY=your-zhipu-key
QWEN_API_KEY=your-qwen-key
ERNIE_API_KEY=your-ernie-key

# Proxy Providers
PROXY_PROVIDER_TYPE=api
PROXY_PROVIDER_NAME=sample-provider
PROXY_PROVIDER_URL=https://api.example.com/proxies
PROXY_PROVIDER_API_KEY=your-proxy-api-key

# Alert Settings
ALERT_EMAIL=your-email@example.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook
WEBHOOK_URL=https://your-webhook-url.com

# Security
JWT_SECRET=your-jwt-secret-key
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring
METRICS_PORT=9090
